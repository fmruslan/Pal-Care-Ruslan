# Copy to .env.local. Never commit real values or personal data.
# fixtures: explicitly labeled bundled preview; no database needed.
# database: PostgreSQL-backed demo records; never silently falls back.
DEMO_DATA_SOURCE=fixtures
DATABASE_URL=
# Local Docker only; choose a strong random password, then use it in DATABASE_URL.
LOCAL_POSTGRES_PASSWORD=

# Dedicated integration database, with a name ending in _test. Never use a deployed database.
TEST_DATABASE_URL=

# Optional Stage 2. Disabled by default; no fake payment mode exists.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
APP_ORIGIN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# Optional separate database credential for the checkout write service; defaults to DATABASE_URL.
CHECKOUT_DATABASE_URL=

# Optional operator-only scope for ONE approved USD 129.00 headphones test.
# Leave all three blank for normal behavior. Do not publish a real request ID or session digest.
# When scoped, false blocks new creation until the buyer confirms available Sandbox USD balance.
PAYPAL_IMMEDIATE_TEST_REQUEST_ID=
PAYPAL_IMMEDIATE_TEST_SESSION_HASH=
PAYPAL_IMMEDIATE_TEST_BALANCE_CONFIRMED=

# CareOS defaults to explicit fixture responses; no paid calls without all live gates.
CAREOS_PROVIDER=fixture
CAREOS_LIVE_ENABLED=false
CAREOS_API_KEY=
CAREOS_MODEL=gpt-5.4-mini-2026-03-17
CAREOS_RESPONSES_BASE_URL=https://api.openai.com/v1
# Least-privilege CareOS writer; leave blank to use DATABASE_URL locally.
CAREOS_DATABASE_URL=
# Integer micro-USD (1 USD = 1000000). Leave blank until budget approval.
CAREOS_DAILY_BUDGET_MICRO=
CAREOS_TOTAL_BUDGET_MICRO=
CAREOS_BUDGET_ID=
# AG Studio and Channel3 are not connected.
# Stage 4 implementation defaults OFF. Approval to implement is not approval to transact.
GUARDIAN_OPERATIONS_ENABLED=false
PRICE_GUARDIAN_CHECKOUT_ENABLED=false
GUARDIAN_REFUNDS_ENABLED=false
GUARDIAN_PROVIDER_READS_ENABLED=false
GUARDIAN_SCHEDULED_MONITORING_ENABLED=false
# Private least-privilege writer (scripts/guardian-role.sql); mandatory for provider access.
GUARDIAN_DATABASE_URL=
# One separately approved case/capture and permanent experiment budget identifier.
GUARDIAN_ALLOWED_CASE_ID=
GUARDIAN_ALLOWED_CAPTURE_ID=
GUARDIAN_EXPERIMENT_ID=
# Keep all provider credentials server-only. Never use NEXT_PUBLIC_ for secrets.
