# Stage 1. Copy to .env.local. Never commit real values or personal data.
# fixtures: explicitly labeled bundled preview; no database needed.
# database: PostgreSQL-backed sample records; never silently falls back.
DEMO_DATA_SOURCE=fixtures
DATABASE_URL=
# Local Docker only; choose a strong random password, then use it in DATABASE_URL.
LOCAL_POSTGRES_PASSWORD=

# No PayPal, AI, AG Studio or Channel3 credentials are needed in Stage 1.
# Future provider credentials must remain server-only. Never use NEXT_PUBLIC_ for secrets.
