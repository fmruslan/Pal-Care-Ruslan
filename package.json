{
  "name": "pal-care",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check src tests scripts/*.ts *.ts *.mjs package.json components.json compose.yaml render.yaml",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:guardian:e2e": "E2E_DATA_SOURCE=database E2E_PORT=3106 playwright test --config=playwright.guardian.config.ts",
    "test:compat": "playwright test --config=playwright.compat.config.ts",
    "test:failure": "tsx --test tests/failure/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "paypal:verify": "tsx scripts/verify-paypal.ts",
    "careos:cleanup": "tsx scripts/cleanup-careos.ts",
    "careos:evaluate": "tsx scripts/evaluate-careos.ts",
    "operator": "tsx scripts/operator.ts",
    "guardian:job": "tsx scripts/guardian-job.ts",
    "guardian:verify": "tsx scripts/verify-guardian.ts",
    "cpsc:verify": "tsx scripts/cpsc.ts verify",
    "cpsc:refresh": "tsx scripts/cpsc.ts refresh",
    "channel3:verify": "tsx scripts/verify-channel3.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "2.5.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "geist": "1.8.2",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "openai": "7.43.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
